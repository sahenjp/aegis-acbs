  "cards": [
    {
      "dot": "cyan",
      "title": "Termination",
      "items": [
        "The stop test compares the sum of the two frontier minima against the incumbent",
        "That sum reduces to gF + gB, which is the known g-bound",
        "This is Siag et al. IJCAI 2023 bound B3, not a new bound"
      ]
    },
    {
      "dot": "amber",
      "title": "What Is Tuned",
      "items": [
        "The scheduler decides which frontier receives the next edge-work chunk",
        "It never changes the potential, the incumbent or the stop test",
        "The aegis-static ablation removes only the scheduler"
      ]
    },
    {
      "dot": "emerald",
      "title": "Measured",
      "items": [
        "Real OSM networks: Tokyo and Osaka, distance and travel-time metrics",
        "Every query returned an exact shortest path",
        "The gain shrinks as the geographic bound carries less information"
      ]
    }
